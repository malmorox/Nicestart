<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Nicestart" parent="Theme.MaterialComponents.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorPrimary">@color/colorPrincipal</item>
    </style>

    <style name="Theme.Nicestart" parent="Base.Theme.Nicestart" />

    <style name="Theme.Nicestart.ActionBar.Transparent" parent="Theme.MaterialComponents.DayNight">
        <item name="android:textColorPrimary">@color/blanco</item>
        <item name="actionBarStyle">@style/TransparentActionBar</item>
    </style>

    <style name="Theme.Nicestart.ActionBar" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrincipal</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="actionBarStyle">@style/MyActionBar</item>
    </style>

    <style name="MyActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/colorPrincipal</item>
    </style>

    <style name="Theme.Nicestart.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <style name="TransparentActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <!-- EL SHOW HOME ES PARA QUE SOLO APAREZCA LA FLECHA DE VOLVER ATRÁS Y NO EL NOMBRE COMPLETO DE LA APP -->
        <item name="displayOptions">showHome</item>
    </style>
</resources>